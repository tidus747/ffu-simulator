{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/preload/api.ts",
    "src/core/**/*.ts",
    "src/worker/protocol.ts",
    "tests/**/*.ts"
  ]
}
